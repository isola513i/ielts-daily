      "kind": "button",
      "refersTo": "sound-button",
      "description": "Circular term-audio control; 44px on phones.",
      "html": "<button class=\"ds-sound\" aria-label=\"ฟังคำศัพท์\"><svg width=\"23\" height=\"23\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"m11 5-6 4H2v6h3l6 4V5Zm4 3a6 6 0 0 1 0 8m3-11a10 10 0 0 1 0 14\"/></svg></button>",
      "css": ".ds-sound{display:grid;place-items:center;width:48px;height:48px;border:0;border-radius:50%;background:var(--teal-soft);color:var(--teal);cursor:pointer;transition:background 160ms}.ds-sound:hover{background:#cde3d7}.ds-sound:focus-visible{outline:3px solid var(--focus);outline-offset:4px}@media(prefers-reduced-motion:reduce){.ds-sound{transition:none!important;animation:none!important}}"
