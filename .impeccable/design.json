      "html": "<button class=\"ds-button-secondary\">ยังจำไม่ได้</button>",
      "css": ".ds-button-secondary{font-family:var(--font);display:inline-flex;align-items:center;justify-content:center;gap:10px;min-height:52px;padding:13px 20px;border:1px solid transparent;border-radius:10px;font-size:15px;font-weight:600;line-height:1.6;cursor:pointer;transition:background 160ms,color 160ms,box-shadow 160ms;background:var(--surface);color:var(--ink);border-color:var(--line);}.ds-button-secondary:hover{background:var(--teal-soft);border-color:#8aafa0}.ds-button-secondary:focus-visible{outline:3px solid var(--focus);outline-offset:4px}.ds-button-secondary:active{transform:translateY(1px)}@media(prefers-reduced-motion:reduce){.ds-button-secondary{transition:none!important;animation:none!important}}"
    },
    {
