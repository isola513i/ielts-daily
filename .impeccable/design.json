  "components": [
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Standard study action; mobile answer buttons use a 56px minimum.",
      "html": "<button class=\"ds-button-primary\">ดูเฉลย</button>",
      "css": ".ds-button-primary{font-family:var(--font);display:inline-flex;align-items:center;justify-content:center;gap:10px;min-height:52px;padding:13px 20px;border:1px solid transparent;border-radius:10px;font-size:15px;font-weight:600;line-height:1.6;cursor:pointer;transition:background 160ms,color 160ms,box-shadow 160ms;background:var(--teal);color:var(--surface);}.ds-button-primary:hover{background:var(--teal-hover)}.ds-button-primary:focus-visible{outline:3px solid var(--focus);outline-offset:4px}.ds-button-primary:active{transform:translateY(1px)}@media(prefers-reduced-motion:reduce){.ds-button-primary{transition:none!important;animation:none!important}}"
    },
