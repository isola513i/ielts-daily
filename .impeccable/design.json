      "css": ".ds-word-class{font-family:var(--font);display:inline-block;font-size:12px;font-style:italic;color:var(--teal);background:var(--teal-soft);padding:2px 9px;border-radius:5px}"
    },
    {
      "name": "Accent Choice",
      "kind": "input",
      "refersTo": "accent-choice",
      "description": "Native radio semantics with the full row as the target.",
      "html": "<label class=\"ds-choice\"><input type=\"radio\" name=\"ds-accent\" checked><span class=\"ds-code\">UK</span><span class=\"ds-desc\"><strong>British English</strong><span>สหราชอาณาจักร</span></span><span class=\"ds-radio\"></span></label>",
      "css": ".ds-choice{font-family:var(--font);position:relative;display:flex;align-items:center;gap:18px;min-height:100px;padding:18px 20px;border:1px solid var(--line);border-radius:12px;cursor:pointer;background:var(--surface);color:var(--ink)}.ds-choice:has(input:checked){border-color:var(--teal);background:var(--teal-soft)}.ds-choice:hover{border-color:#8aafa0}.ds-choice:has(input:focus-visible){outline:3px solid var(--focus);outline-offset:4px}.ds-choice input{position:absolute;inset:0;width:100%;height:100%;opacity:0;margin:0;cursor:pointer}.ds-code{display:grid;place-items:center;width:42px;height:46px;border-radius:8px;background:var(--paper);color:var(--teal);font-size:15px;font-weight:600}.ds-desc{flex:1}.ds-desc strong{display:block;font-size:17px;font-weight:600}.ds-desc>span{display:block;font-size:12px;color:var(--muted)}.ds-radio{width:20px;height:20px;border:1.5px solid #8a9b92;border-radius:50%}input:checked~.ds-radio{border:6px solid var(--teal);background:white}"
    },
    {
      "name": "Desktop Navigation",
      "kind": "nav",
      "refersTo": "nav-active",
      "description": "Active rail destination; mobile uses icon-over-label and an unfilled active state.",
      "html": "<nav><a class=\"ds-nav ds-active\" href=\"#home\" aria-current=\"page\"><svg width=\"21\" height=\"21\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M3 4h6l3 2 3-2h6v15h-6l-3 2-3-2H3V4Z\"/><path d=\"M12 6v15M6 9h3m6 0h3M6 13h3m6 0h3\"/></svg><span>ฝึกคำศัพท์</span></a></nav>",
      "css": ".ds-nav{font-family:var(--font);display:flex;align-items:center;gap:12px;min-height:48px;padding:12px 16px;border-radius:10px;color:var(--muted);font-size:14px;font-weight:500;text-decoration:none}.ds-nav.ds-active{background:#dbe9df;color:#165747;font-weight:650}.ds-nav:hover{background:#e4eae1;color:var(--ink)}.ds-nav:focus-visible{outline:3px solid var(--focus);outline-offset:4px}"
    },
    {
      "name": "Ruled Topic Row",
      "kind": "custom",
      "description": "Chapter-style full-row topic button, without a surrounding card.",
      "html": "<button class=\"ds-topic\"><svg width=\"21\" height=\"21\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M3 4h6l3 2 3-2h6v15h-6l-3 2-3-2H3V4Z\"/><path d=\"M12 6v15M6 9h3m6 0h3M6 13h3m6 0h3\"/></svg><span class=\"ds-topic-copy\"><strong>ชีวิตประจำวัน</strong><span>Daily life</span></span><span class=\"ds-count\">30 คำ</span></button>",
      "css": ".ds-topic{font-family:var(--font);display:flex;align-items:center;gap:16px;min-height:88px;width:100%;padding:16px 2px;border:0;border-bottom:1px solid var(--line);background:transparent;color:var(--ink);text-align:left;cursor:pointer}.ds-topic>svg{color:var(--teal);width:40px}.ds-topic-copy{flex:1}.ds-topic-copy strong{display:block;font-size:14px;font-weight:550}.ds-topic-copy>span{display:block;font-size:12px;color:var(--muted);margin-top:1px}.ds-count{font-size:12px;color:var(--muted);font-variant-numeric:tabular-nums}.ds-topic:hover{background:#edf2eb}.ds-topic:focus-visible{outline:3px solid var(--focus);outline-offset:4px}"
    }
  ],
  "narrative": {
    "northStar": "A bilingual pocket phrasebook",
    "overview": "Warm pale paper, deep ink and restrained teal frame real study text. DM Sans and Noto Sans Thai share one font stack, so English entries and Thai guidance feel like the same book. Ruled topic rows and compact numeric references supply structure without ornament.\n\nThis is a calm, personal study interface: generous space around the current word, compact supporting instructions and a clear next action. The shipped visual system uses authored SVG line icons and self-hosted fonts; it has no photographic or generated raster imagery.",
    "keyCharacteristics": [
      "Warm pale surfaces with dark ink and teal actions.",
      "Large English entries with bilingual supporting text.",
      "Ruled topic rows and quiet reading notes.",
      "Desktop rail, mobile bottom navigation and a stripped-back study view."
    ],
    "rules": [
      {
        "name": "The Teal Action Rule",
        "body": "Use teal for the next study action and state feedback; keep supporting content on quiet paper tones.",
        "section": "colors"
      },
      {
        "name": "The Word First Rule",
        "body": "The English entry is the strongest typographic element on a study card; definitions and Thai meanings remain clearly subordinate.",
        "section": "typography"
      },
      {
        "name": "The Paper Depth Rule",
        "body": "Use background tone and ruled separation for ordinary hierarchy; reserve the existing soft shadow for the word entry.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do keep Thai guidance and English study material in the shared self-hosted font stack.",
      "Do preserve visible keyboard focus and the existing generous touch targets.",
      "Do separate topic and review rows with fine rules.",
      "Do keep mobile study controls in document flow and honor reduced motion."
    ],
    "donts": [
      "Don't replace the authored SVG line icons with text glyph icons.",
      "Don't add a 3D card flip to the reveal interaction.",
