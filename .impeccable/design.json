      "html": "<article class=\"ds-entry\"><h1>appointment</h1><p>คำนี้หมายความว่าอะไร?</p></article>",
      "css": ".ds-entry{font-family:var(--font);padding:28px 36px 30px;background:var(--surface);color:var(--ink);border-radius:var(--radius);box-shadow:0 4px 24px #20382c06}.ds-entry h1{margin:28px 0 0;font-size:48px;font-weight:550;line-height:1.2;letter-spacing:-.03em;overflow-wrap:anywhere}.ds-entry p{font-size:12px;color:var(--muted);margin:12px 0 0}"
    },
